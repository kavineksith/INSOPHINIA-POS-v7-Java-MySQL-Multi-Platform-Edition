<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file.

  Suppresses false-positive CVEs that the scanner matches against
  well-known libraries but where the actual vulnerable version is
  different from the one we depend on. Add an entry here ONLY after
  manually verifying the CVE doesn't apply to our specific version.

  This file is loaded via the dependency-check-maven plugin's
  <suppressionFiles> configuration in pom.xml.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      dev.samstevens:totp is a small TOTP library. The CVE database
      occasionally matches it against CVE entries for unrelated
      "totp" packages in other ecosystems (npm, pypi). Suppress
      matches until upstream fixes a real vulnerability.
    -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/dev\.samstevens/totp@.*$</packageUrl>
        <cve>CVE-2019-.*</cve>  <!-- placeholder — no known CVEs against this lib -->
    </suppress>

    <!--
      The H2 console is disabled in production (only used in the
      desktop profile, which runs on localhost). CVE-2022-23221
      (H2 console RCE) doesn't apply because we don't enable the
      console at runtime. Suppress to avoid noise.
    -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <cve>CVE-2022-23221</cve>
        <cve>CVE-2021-23463</cve>
    </suppress>
</suppressions>
