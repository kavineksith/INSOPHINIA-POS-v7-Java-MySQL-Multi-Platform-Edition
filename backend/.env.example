# =============================================================================
# INSOPHINIA POS Backend — runtime environment template
# =============================================================================
# Copy this file to `.env` (in the backend/ folder or repo root) and replace
# every CHANGE_ME / placeholder value with a real, secure value. NEVER commit
# the resulting `.env` file to source control.
#
# Three environment tiers should be configured separately:
#   dev  — local workstation (verbose SQL logs, relaxed rate limits)
#   test — Testcontainers MySQL (no manual setup needed)
#   prod — production (HTTPS, locked-down CORS, hardened rate limits)
# =============================================================================

# Spring profile: dev | test | prod | desktop
SPRING_PROFILES_ACTIVE=dev

# Network
SERVER_ADDRESS=127.0.0.1
PORT=8080

# MySQL connection (production: omit createDatabaseIfNotExist and
# allowPublicKeyRetrieval; provide a dedicated low-privilege user)
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/insophinia_pos?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DATABASE_USER=insophinia
DATABASE_PASSWORD=CHANGE_ME
DB_POOL_MAX=10
DB_POOL_MIN=2

# Auth — JWT signing (must be a long random hex/base64 string, min 32 bytes)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_HOURS=1

# Cron endpoint protection (POST /api/cron/backups requires this header)
CRON_SECRET=CHANGE_ME

# SMTP for receipts + test-email endpoint. In dev, point at a MailHog/Papercut
# stub on port 1025 (no auth, no TLS). In prod, point at your real SMTP server.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Master admin seed (created on first boot if no master_admin row exists)
SEED_ADMIN_USERNAME=master
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Backup encryption key (must be exactly 32 UTF-8 bytes when padded to bytes)
BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_FOR_AES_256
BACKUP_DIR=./backups

# TOTP secret encryption key (AES-256-GCM, must be 32 UTF-8 bytes)
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_FOR_TOTP_AES

# Log retention (system_logs + security_events purge older than this)
LOG_RETENTION_HOURS=24

# Password policy
PASSWORD_EXPIRY_DAYS=7

# CORS allow-list (comma-separated)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Optional: customer-display channel pairing (per terminal)
POS_DISPLAY_CHANNELS=
POS_DISPLAY_CHANNEL=

# Test profile (used by `mvn test` via Testcontainers — values here are
# overridden by Testcontainers at runtime, but provide sensible fallbacks)
TEST_DATABASE_URL=jdbc:tc:mysql:8.0:///insophinia_test
TEST_DATABASE_USER=test
TEST_DATABASE_PASSWORD=test
