<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.insophinia</groupId>
    <artifactId>insophinia-pos-desktop</artifactId>
    <version>7.0.0-SNAPSHOT</version>
    <name>INSOPHINIA POS Desktop (JavaFX)</name>
    <properties>
        <java.version>17</java.version>
        <javafx.version>21.0.5</javafx.version>
    </properties>
    <dependencies>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
        <!-- v7: WebView for A4 receipt rendering (HTML → print) + javafx-web for the print dialog -->
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-web</artifactId><version>${javafx.version}</version></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>com.fazecast</groupId><artifactId>jSerialComm</artifactId><version>2.11.0</version></dependency>
        <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.5</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
        <!-- TestFX for headless JavaFX smoke tests. Requires the JavaFX runtime
             on the module path; the surefire configuration below adds the
             necessary - -add-modules JVM flag so the TestFX-driven LoginView
             smoke test can run in CI without a display server. -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <!-- Monocle provides a headless JavaFX rendering backend so TestFX
             can run in CI without an X server. -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>17.0.10</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- By default, exclude the TestFX smoke test — it needs
                         the JavaFX runtime on the module path (provided by
                         the testfx profile below). Without the profile, the
                         forked JVM can't initialize JavaFX and would crash.
                         CI explicitly activates the profile to run TestFX. -->
                    <excludes>
                        <exclude>**/LoginViewTestFxSmokeTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.insophinia.pos.desktop.PosDesktopApp</mainClass>
                </configuration>
            </plugin>
            <!-- CycloneDX SBOM generation for the desktop module. CI uploads
                 both backend + desktop BOMs as a single artifact. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.8.1</version>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.5</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeTestScope>false</includeTestScope>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-sbom</id>
                        <phase>package</phase>
                        <goals><goal>makeBom</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profile: testfx — activates the headless JavaFX runtime on the
         module path so TestFX tests can run. Activate explicitly:
             mvn -Ptestfx test
         The CI workflow enables this profile on the desktop test job.
         Without this profile, the surefire exclude keeps TestFX tests off
         so the JVM doesn't crash trying to initialize JavaFX. -->
    <!-- Profile: jpackage — produces a native installer (.msi on Windows,
         .deb / .rpm on Linux, .dmg on macOS) for the desktop client.
         Activate explicitly:
             mvn -Pjpackage,-Pjpackage-linux package
         Requires JDK 17+ and the jpackage tool (bundled since JDK 14+).
         The output is target/jpackage/insophinia-pos-desktop-<version>.<ext>.
         Cross-building is NOT supported by jpackage — build on each target
         OS separately. -->
    <profiles>
        <profile>
            <id>testfx</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <excludes combine.self="override"/>
                            <argLine>--add-modules javafx.controls,javafx.graphics,javafx.base,javafx.web --add-exports javafx.graphics/com.sun.glass.ui=ALL-UNNAMED -Dtestfx.monocle=yes -Djava.awt.headless=true</argLine>
                            <systemPropertyVariables>
                                <testfx.headless>true</testfx.headless>
                                <monocle.platform>HEADLESS</monocle.platform>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jpackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.1</version>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>com.insophinia.pos.desktop.PosDesktopApp</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </plugin>
                    <plugin>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <groupId>org.pantekeypress</groupId>
                        <version>0.4.0</version>
                        <executions>
                            <execution>
                                <id>build-installer</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <!-- The fat jar produced by maven-jar-plugin. -->
                                    <input>${project.build.directory}</input>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>com.insophinia.pos.desktop.PosDesktopApp</mainClass>
                                    <name>INSOPHINIA-POS-Desktop</name>
                                    <appVersion>${project.version}</appVersion>
                                    <vendor>INSOPHINIA</vendor>
                                    <licenseFile>LICENSE</licenseFile>
                                    <!-- OS-specific installer type. jpackage
                                         picks the right default per platform:
                                         .msi on Windows, .deb/.rpm on Linux,
                                         .dmg/.pkg on macOS. -->
                                    <type>${jpackage.type}</type>
                                    <!-- JVM options passed to the bundled JRE. -->
                                    <javaOptions>
                                        <javaOption>-Xmx512m</javaOption>
                                        <javaOption>-Dfile.encoding=UTF-8</javaOption>
                                        <javaOption>-Duser.timezone=UTC</javaOption>
                                    </javaOptions>
                                    <!-- File associations for .posbak backups
                                         (so operators can double-click a
                                         backup file to launch the desktop's
                                         restore wizard). -->
                                    <fileAssociations>
                                        <fileAssociation>
                                            <extensions>posbak</extensions>
                                            <mimeType>application/x-insophinia-pos-backup</mimeType>
                                            <description>INSOPHINIA POS encrypted backup</description>
                                        </fileAssociation>
                                    </fileAssociations>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <!-- Default to the host OS's native installer type. Override
                     with -Djpackage.type=msi|deb|rpm|pkg|dmg|app-image. -->
                <jpackage.type>app-image</jpackage.type>
            </properties>
        </profile>
    </profiles>
</project>
